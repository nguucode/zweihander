  },

  "control": {
    "$description": "Control heights: Button, fields, tabs, pagination, sidebar rows. Two steps, as in the Claude apps: 32px is the default, 24px the small inline control. The generator multiplies each by --scaling. On touch screens components widen the hit area to 44px without growing the visible box.",
    "sm": { "$type": "dimension", "$value": "1.5rem" },
    "md": { "$type": "dimension", "$value": "2rem" }
  },

  "text": {
    "$description": "Type roles. Each size pairs with a leading ratio of the same name, so the line height follows the size under --scaling.",
    "heading-2xl": { "$type": "dimension", "$value": "2rem", "$extensions": { "leading": "36 / 32" } },
    "heading-xl": { "$type": "dimension", "$value": "1.75rem", "$extensions": { "leading": "32 / 28" } },
    "heading-lg": { "$type": "dimension", "$value": "1.5rem", "$extensions": { "leading": "28 / 24" } },
