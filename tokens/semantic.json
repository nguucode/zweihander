  "shadow": {
    "$description": "Elevation has two levels. raised is for a surface that can be picked up and moved (a dragged card); overlay is for anything that floats above the page: menus, popovers, modals, toasts. A card that stays put has no shadow: it is a surface with a border. Each level is a soft directional layer over a 1px ambient edge. The seven step names (2xs to 2xl) are aliases of the two levels, kept so existing styles keep working: 2xs to sm read raised, md to 2xl read overlay.\n\nOnly the light values are written. The generator derives dark from them, because a black shadow has little left to darken on a dark surface — see $extensions.",
    "$extensions": {
      "dark": {
        "alphaScale": 4,
        "alphaMax": 0.6,
        "$description": "Dark multiplies every alpha and clamps it. The clamp matters: past roughly 0.6 a shadow stops reading as elevation and starts reading as a dark smudge, so the top step gains contrast by other means (a lighter surface) rather than by a heavier shadow."
      }
    },
    "elevation-none": { "$type": "shadow", "$value": "0 0 #0000" },
    "elevation-raised": { "$type": "shadow", "$value": "0 1px 1px 0 rgb(0 0 0 / 0.25), 0 0 1px 0 rgb(0 0 0 / 0.31)" },
    "elevation-overlay": { "$type": "shadow", "$value": "0 8px 12px 0 rgb(0 0 0 / 0.15), 0 0 1px 0 rgb(0 0 0 / 0.31)" },
    "elevation-2xs": { "$type": "shadow", "$value": "{shadow.elevation-raised}" },
    "elevation-xs": { "$type": "shadow", "$value": "{shadow.elevation-raised}" },
    "elevation-sm": { "$type": "shadow", "$value": "{shadow.elevation-raised}" },
    "elevation-md": { "$type": "shadow", "$value": "{shadow.elevation-overlay}" },
    "elevation-lg": { "$type": "shadow", "$value": "{shadow.elevation-overlay}" },
    "elevation-xl": { "$type": "shadow", "$value": "{shadow.elevation-overlay}" },
    "elevation-2xl": { "$type": "shadow", "$value": "{shadow.elevation-overlay}" }
  },

  "root": {
    "$description": "Appearance-independent. These live on :root alone — never on .light — so a nested light scope inherits them instead of resetting them.",
    "radius": { "$type": "dimension", "$value": "0.375rem", "$description": "The md step (6px): buttons and fields. The scale is cut from it: xs a third (2px), sm two thirds (4px), lg four thirds (8px), xl twice (12px), 2xl eight thirds (16px)." },
    "radius-factor": { "$type": "number", "$value": 1 },
    "radius-full": { "$type": "dimension", "$value": "0px" },
    "radius-pill": { "$type": "dimension", "$value": "9999px" },
    "cursor-button": { "$type": "other", "$value": "default" },
    "cursor-link": { "$type": "other", "$value": "pointer" },
    "cursor-disabled": { "$type": "other", "$value": "not-allowed" },
    "font-sans": {
      "$type": "fontFamily",
      "$value": "system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif, 'Apple Color Emoji', 'Segoe UI Emoji'"
    },
    "font-heading": { "$type": "fontFamily", "$value": "var(--font-sans)" },
    "font-prose": { "$type": "fontFamily", "$value": "var(--font-sans)" },
    "font-mono": {
      "$type": "fontFamily",
      "$value": "ui-monospace, SFMono-Regular, 'SF Mono', Menlo, Consolas, 'Liberation Mono', monospace"
    }
  },

  "space": {
    "$description": "Two kinds. The six roles (stack to section) are what layout and component spacing read: pick by what the gap does, and each role has one value. The numeric steps are raw multiples of 0.25rem for the few places no role fits.",
    "0-5": { "$type": "dimension", "$value": "0.125rem" },
    "1": { "$type": "dimension", "$value": "0.25rem" },
    "1-5": { "$type": "dimension", "$value": "0.375rem" },
    "2": { "$type": "dimension", "$value": "0.5rem" },
    "2-5": { "$type": "dimension", "$value": "0.625rem" },
    "3": { "$type": "dimension", "$value": "0.75rem" },
    "4": { "$type": "dimension", "$value": "1rem" },
    "5": { "$type": "dimension", "$value": "1.25rem" },
    "6": { "$type": "dimension", "$value": "1.5rem" },
    "8": { "$type": "dimension", "$value": "2rem" },
    "10": { "$type": "dimension", "$value": "2.5rem" },
    "12": { "$type": "dimension", "$value": "3rem" },
    "16": { "$type": "dimension", "$value": "4rem" },
    "20": { "$type": "dimension", "$value": "5rem" },
    "stack": { "$type": "dimension", "$value": "0.25rem", "$description": "Lines of text under each other: title to description, label to value." },
    "inline": { "$type": "dimension", "$value": "0.5rem", "$description": "Small things side by side: icon to text, label to value on one line, sidebar items." },
    "cluster": { "$type": "dimension", "$value": "0.75rem", "$description": "Controls or parts that sit together: filters in a toolbar, an avatar to its content, the parts of a page heading, inside a small card." },
    "group": { "$type": "dimension", "$value": "1rem", "$description": "Between items and blocks that belong together: cards in a row, toolbar to table, table cell sides." },
    "container": { "$type": "dimension", "$value": "1.5rem", "$description": "Inside the edge of a card, panel or page heading." },
    "section": { "$type": "dimension", "$value": "1.5rem", "$description": "Page edge and between page sections. AppShell applies it to the page edge from 64rem up." }
  },

  "box": {
    "$description": "The box ramp: every fixed height and fixed square in the kit stands on one of these six steps, so one role always gets one size. md (32px) is the default. Control heights alias xs, sm and md. Off the ramp, each with a reason: 1-2px strokes, dots and bars under 12px, switch track widths, region sizes, the 44px touch target, icons in text. The build checks that control, size and row values stand on the ramp.",
    "2xs": { "$type": "dimension", "$value": "1rem" },
    "xs": { "$type": "dimension", "$value": "1.25rem" },
    "sm": { "$type": "dimension", "$value": "1.5rem" },
    "md": { "$type": "dimension", "$value": "2rem" },
    "lg": { "$type": "dimension", "$value": "2.5rem" },
    "xl": { "$type": "dimension", "$value": "3rem" }
  },

  "control": {
    "$description": "Size tiers. Heights alias the box ramp (box.xs, box.sm, box.md). One tier binds a control's height, inline padding and icon-to-label gap; its icon is --icon-{tier} and its radius --control-{tier}-radius (generated, see Radius). md (32px) is the default control and the small field, lg (40px) the default field, sm (24px) the small inline control, xs (20px) only for compact parts: Tag sm, the slider thumb (the checkbox box, Badge, switch and Avatar have their own sizes, see size). Buttons and fields have no xs: a 20px button reads as a part, not a control. Fields have no sm either: the smallest field is 32px. The 24px floor of WCAG 2.5.8 is for the hit area: a box drawn smaller widens its hit area to 24px. pad is for fields and rows, whose text lines up with a label; pad-spacious is for buttons, whose centred label needs room. On touch screens components widen the hit area to 44px without growing the visible box.",
    "xs": { "$type": "dimension", "$value": "{box.xs}" },
    "sm": { "$type": "dimension", "$value": "{box.sm}" },
    "md": { "$type": "dimension", "$value": "{box.md}" },
    "lg": { "$type": "dimension", "$value": "{box.lg}", "$description": "The default field (40px), after Atlassian: a field is one step taller than the button beside it, and its small size is md (32px), which lines up with a button in a toolbar. lg is a height only: a field keeps the md icon, gap, radius and type." },
    "xs-pad": { "$type": "dimension", "$value": "0.375rem" },
    "sm-pad": { "$type": "dimension", "$value": "0.5rem" },
    "md-pad": { "$type": "dimension", "$value": "0.625rem" },
    "xs-pad-spacious": { "$type": "dimension", "$value": "0.375rem" },
    "sm-pad-spacious": { "$type": "dimension", "$value": "0.5rem" },
    "md-pad-spacious": { "$type": "dimension", "$value": "0.75rem" },
    "xs-gap": { "$type": "dimension", "$value": "0.25rem" },
    "sm-gap": { "$type": "dimension", "$value": "0.375rem" },
    "md-gap": { "$type": "dimension", "$value": "0.5rem" }
  },

  "row": {
    "$description": "Row height for tables and lists: box-md plus space-inline above and below (48px). The build checks the sum.",
    "height": { "$type": "dimension", "$value": "3rem" }
  },

  "size": {
    "$description": "Component sizes, emitted unprefixed (--avatar-md).",
    "choice-box": { "$type": "dimension", "$value": "1.25rem" },
    "radio-dot-size": { "$type": "dimension", "$value": "0.5rem" },
    "switch-sm-w": { "$type": "dimension", "$value": "1.75rem" },
    "switch-sm-h": { "$type": "dimension", "$value": "1rem" },
    "switch-md-w": { "$type": "dimension", "$value": "2.25rem" },
    "switch-md-h": { "$type": "dimension", "$value": "1.25rem" },
    "switch-lg-w": { "$type": "dimension", "$value": "2.75rem" },
    "switch-lg-h": { "$type": "dimension", "$value": "1.5rem" },
    "progress-sm": { "$type": "dimension", "$value": "0.25rem" },
    "progress-md": { "$type": "dimension", "$value": "0.5rem" },
    "progress-lg": { "$type": "dimension", "$value": "0.75rem" },
    "avatar-xs": { "$type": "dimension", "$value": "1.5rem" },
    "avatar-sm": { "$type": "dimension", "$value": "2rem" },
    "avatar-md": { "$type": "dimension", "$value": "2.5rem" },
    "avatar-lg": { "$type": "dimension", "$value": "3rem" },
    "badge-sm": { "$type": "dimension", "$value": "1rem" },
    "badge-md": { "$type": "dimension", "$value": "1.25rem" },
    "badge-dot-sm": { "$type": "dimension", "$value": "0.375rem" },
    "badge-dot-md": { "$type": "dimension", "$value": "0.5rem" },
    "sidebar-width": { "$type": "dimension", "$value": "16rem", "$description": "An expanded Sidebar, and the brand cell above it in an AppShell's top bar, so the logo sits in the same place in either layout." }
  },

  "icon": {
    "$description": "Icon sizes, one per control tier.",
    "xs": { "$type": "dimension", "$value": "0.75rem" },
    "sm": { "$type": "dimension", "$value": "0.875rem" },
    "md": { "$type": "dimension", "$value": "1rem" },
    "lg": { "$type": "dimension", "$value": "1.25rem", "$description": "Icon inside a md Button or ToggleButton: larger than the md control tier, still inside the 32px box." }
  },

  "duration": {
    "$description": "Transition and spinner timing. fast/base/slow are the only transition durations; under prefers-reduced-motion the generator sets them to 0 in one place. A spinner never stops (it is the only sign of work), so reduced motion slows it to spin-reduced instead. Loop animations with their own rhythm (skeleton pulse, progress slide) keep their own timing.",
    "fast": { "$type": "duration", "$value": "100ms" },
    "base": { "$type": "duration", "$value": "150ms" },
    "slow": { "$type": "duration", "$value": "200ms" },
    "spin": { "$type": "duration", "$value": "800ms" },
    "spin-reduced": { "$type": "duration", "$value": "2.5s" }
  },

  "focus": {
    "$description": "The focus ring: outline: var(--focus-width) solid var(--ring). offset draws it outside a free-standing element; offset-inset draws it inside, for elements flush with the edge of a container that clips (tabs, rows, accordion headers, close buttons in a panel). Not scaled: a ring is a stroke, not a size.",
    "width": { "$type": "dimension", "$value": "2px" },
    "offset": { "$type": "dimension", "$value": "2px" },
    "offset-inset": { "$type": "dimension", "$value": "-2px" }
  },

  "border": {
    "$description": "Stroke widths, in whole pixels: a stroke does not follow the root font size. width is every border and rule; width-selected marks the selected or current item (a tab's indicator, a table header's rule).",
    "width": { "$type": "dimension", "$value": "1px" },
    "width-selected": { "$type": "dimension", "$value": "2px" }
  },

  "layer": {
    "$description": "Stacking order for everything that leaves the flow. Popovers, menus, listboxes and modals share overlay: they are portalled, so a later one (a menu opened inside a modal) paints above an earlier one. Values inside a single component (-1, 1, 2) are local and stay literal.",
    "sticky": { "$type": "number", "$value": 10 },
    "overlay": { "$type": "number", "$value": 50 },
    "tooltip": { "$type": "number", "$value": 60 },
    "toast": { "$type": "number", "$value": 70 }
  },

  "target": {
    "$description": "Minimum hit area on touch screens, for use inside @media (pointer: coarse). Components grow the hit area, never the visible box. Not scaled: it is a finger, not a design size.",
    "coarse": { "$type": "dimension", "$value": "44px" }
  },

  "text": {
    "$description": "Type roles. Each size pairs with a leading ratio of the same name.",
    "heading-2xl": { "$type": "dimension", "$value": "2rem", "$extensions": { "leading": "36 / 32" } },
    "heading-xl": { "$type": "dimension", "$value": "1.75rem", "$extensions": { "leading": "32 / 28" } },
    "heading-lg": { "$type": "dimension", "$value": "1.5rem", "$extensions": { "leading": "28 / 24" } },
    "heading-md": { "$type": "dimension", "$value": "1.25rem", "$extensions": { "leading": "24 / 20" } },
    "heading-sm": { "$type": "dimension", "$value": "1rem", "$extensions": { "leading": "20 / 16" } },
    "heading-xs": { "$type": "dimension", "$value": "0.875rem", "$extensions": { "leading": "20 / 14" } },
    "heading-2xs": { "$type": "dimension", "$value": "0.75rem", "$extensions": { "leading": "16 / 12" } },
    "body-lg": { "$type": "dimension", "$value": "1rem", "$extensions": { "leading": "24 / 16" } },
    "body": { "$type": "dimension", "$value": "0.875rem", "$extensions": { "leading": "20 / 14" } },
    "body-sm": { "$type": "dimension", "$value": "0.75rem", "$extensions": { "leading": "16 / 12" } },
    "body-xs": { "$type": "dimension", "$value": "0.75rem", "$description": "Deprecated: the same as body-sm. 12px is the smallest text size; use body-sm.", "$extensions": { "leading": "16 / 12" } }
  }
}
