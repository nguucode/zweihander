  "shadow": {
    "$description": "Elevation, as a height `h` in pixels. Every step is the same two layers: an ambient layer `0 h 2h -h/2` for the spread of light around a raised object, under a tighter contact layer `0 h/2 h -h/2` for where it meets the surface. h doubles through the lower steps and eases off at the top, so the scale reads as distance rather than as seven unrelated blurs.\n\nOnly the light values are written. The generator derives dark from them, because a black shadow has little left to darken on a dark surface — see $extensions.",
    "$extensions": {
      "dark": {
        "alphaScale": 4,
        "alphaMax": 0.6,
        "$description": "Dark multiplies every alpha and clamps it. The clamp matters: past roughly 0.6 a shadow stops reading as elevation and starts reading as a dark smudge, so the top step gains contrast by other means (a lighter surface) rather than by a heavier shadow."
      }
    },
    "elevation-none": { "$type": "shadow", "$value": "0 0 #0000" },
    "elevation-2xs": { "$type": "shadow", "$value": "0 1px 2px 0 rgb(0 0 0 / 0.033)" },
    "elevation-xs": { "$type": "shadow", "$value": "0 2px 4px -1px rgb(0 0 0 / 0.039), 0 1px 2px -1px rgb(0 0 0 / 0.026)" },
    "elevation-sm": { "$type": "shadow", "$value": "0 4px 8px -2px rgb(0 0 0 / 0.052), 0 2px 4px -2px rgb(0 0 0 / 0.033)" },
    "elevation-md": { "$type": "shadow", "$value": "0 8px 16px -4px rgb(0 0 0 / 0.058), 0 4px 8px -4px rgb(0 0 0 / 0.039)" },
    "elevation-lg": { "$type": "shadow", "$value": "0 12px 24px -6px rgb(0 0 0 / 0.065), 0 6px 12px -6px rgb(0 0 0 / 0.046)" },
    "elevation-xl": { "$type": "shadow", "$value": "0 20px 40px -10px rgb(0 0 0 / 0.078), 0 10px 20px -10px rgb(0 0 0 / 0.052)" },
    "elevation-2xl": { "$type": "shadow", "$value": "0 32px 64px -16px rgb(0 0 0 / 0.104), 0 16px 32px -16px rgb(0 0 0 / 0.065)" }
  },

  "root": {
    "$description": "Appearance-independent. These live on :root alone — never on .light — so a nested light scope inherits them instead of resetting them.",
    "radius": { "$type": "dimension", "$value": "0.625rem" },
    "radius-factor": { "$type": "number", "$value": 1 },
    "radius-full": { "$type": "dimension", "$value": "0px" },
    "scaling": { "$type": "number", "$value": 1 },
    "cursor-button": { "$type": "other", "$value": "default" },
    "cursor-link": { "$type": "other", "$value": "pointer" },
    "cursor-disabled": { "$type": "other", "$value": "not-allowed" },
    "font-sans": {
      "$type": "fontFamily",
      "$value": "system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif, 'Apple Color Emoji', 'Segoe UI Emoji'"
    },
    "font-heading": { "$type": "fontFamily", "$value": "var(--font-sans)" },
    "font-prose": { "$type": "fontFamily", "$value": "var(--font-sans)" },
    "font-mono": {
      "$type": "fontFamily",
      "$value": "ui-monospace, SFMono-Regular, 'SF Mono', Menlo, Consolas, 'Liberation Mono', monospace"
    }
  },

  "space": {
