    "oxlint": "^1.81.0",
    "playwright": "latest",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.21.0",
    "storybook": "^10.6.0",
    "storybook-addon-pseudo-states": "10.6.0",
    "stylelint": "^17.16.0",
