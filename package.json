  "scripts": {
    "prepack": "npm run build:lib",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:site": "npm run playground:manifest && vite build --base ./ --outDir site && storybook build -o site/storybook && shadcn build --output site/r",
    "tokens": "node scripts/build-tokens.mjs",
    "tokens:check": "node scripts/build-tokens.mjs --check",
    "registry:check": "node scripts/check-registry.mjs",
    "docs:check": "node scripts/check-docs.mjs && node --test scripts/check-docs.test.mjs",
    "skills:check": "node scripts/check-skills.mjs && node --test scripts/check-skills.test.mjs scripts/ship-check.test.mjs",
    "ship:check": "node scripts/ship-check.mjs",
    "playground:manifest": "node scripts/build-playground-manifest.mjs",
    "playground:check": "node scripts/build-playground-manifest.mjs --check",
    "build:lib": "vite build --config vite.lib.config.ts && tsc -p tsconfig.build.json && cp src/tokens.css dist/tokens.css",
    "lint": "oxlint && npm run lint:css",
    "lint:css": "stylelint \"src/**/*.css\" \".storybook/**/*.css\" && node --test scripts/stylelint-semantic-tokens.test.mjs",
    "verify": "changeset status --since=origin/main && npm run tokens:check && npm run registry:check && npm run docs:check && npm run skills:check && npm run playground:check && npm run lint && tsc -b && vitest --project storybook run && npm run build:lib",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "clsx": "^2.1.1",
