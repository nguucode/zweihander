{
  "plugins": [
    "stylelint-declaration-strict-value"
  ],
  "ignoreFiles": [
    "src/tokens.css",
    "src/App.module.css"
  ],
  "reportDescriptionlessDisables": true,
  "rules": {
    "scale-unlimited/declaration-strict-value": [
      [
        "/^padding/",
        "/^margin/",
        "gap",
        "row-gap",
        "column-gap",
        "/^border(-[a-z]+)*-radius$/",
        "font-size",
        "font-weight",
        "line-height",
        "z-index",
        "transition-duration",
        "animation-duration",
        "outline-offset",
        "outline-width"
      ],
      {
        "ignoreValues": {
          "": [
            "0",
            "inherit",
            "initial",
            "unset",
            "currentColor",
            "transparent",
            "/var\\(--/"
          ],
          "font-weight": [
            "inherit",
            "initial",
            "unset",
            "400",
            "500",
            "600",
            "700",
            "/var\\(--/"
          ],
          "/^margin/": [
            "0",
            "inherit",
            "initial",
            "unset",
            "currentColor",
            "transparent",
            "/var\\(--/",
            "auto"
          ]
        },
        "severity": "error",
        "ignoreFunctions": false
      }
    ]
  }
}
